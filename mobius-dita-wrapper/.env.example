DITA_DATABASE_URL=postgresql+psycopg://dita:dita@localhost:5432/dita_service
DITA_REDIS_URL=redis://localhost:6379/1

# Existing DITA render service (Express, default :8090, prefix /api)
DITA_RENDER_BASE_URL=http://dita-render:8090
DITA_RENDER_API_PREFIX=/api/v1
DITA_RENDER_DITA_PATH=/dita
DITA_RENDER_BOB_LLM_PATH=/dita/bob-llm
DITA_RENDER_BUNDLES_PATH=/bundles
DITA_RENDER_CHUNKS_PATH=/chunks
DITA_RENDER_ACL_PATH=/acl
DITA_RENDER_RESOLVED_RESULTS_PATH=/resolved-results
DITA_RENDER_TIMEOUT_SECONDS=60
# Bearer token passed as Authorization header to render service. Required if its IAM is enabled.
DITA_RENDER_AUTH_HEADER=

DITA_LABOR_GATEWAY_BASE_URL=http://labor-gateway:8000
DITA_LABOR_TIMEOUT_SECONDS=180
# Bearer token forwarded to labor gateway. Blank = no header; per-call override possible via __auth_header in request_payload.
DITA_LABOR_AUTH_HEADER=
DITA_LABOR_RUN_SYNC_PATH=/camunda/labor/run-sync
DITA_LABOR_RUN_ASYNC_PATH=/camunda/labor/run-async
DITA_LABOR_WORKFLOWS_PUBLISH_PATH=/camunda/workflows/publish
DITA_LABOR_RECONCILE_PATH=/camunda/labor/jobs
DITA_LABOR_CALLS_PATH=/labor/calls
DITA_LABOR_JOBS_PATH=/labor/jobs
DITA_LABOR_BATCH_PATH=/labor/batch
DITA_LABOR_CACHE_PREFIX_PATH=/labor/cache-prefix
DITA_LABOR_EXECUTORS_PATH=/executors
DITA_LABOR_EXECUTOR_POLICIES_PATH=/executor-policies
DITA_LABOR_MODEL_POLICIES_PATH=/model-policies
DITA_BOB_BASE_URL=http://bob-service:8080
DITA_AUTH_DISABLED=false
