<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="document_pipeline_defs" targetNamespace="http://mobius/dita">
  <bpmn:process id="document_pipeline" name="Document Pipeline" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <!-- COARSE: whole document job as one external task -->
    <bpmn:serviceTask id="document_job" name="Run document job"
                      camunda:type="external" camunda:topic="dita.document_job"/>
    <bpmn:exclusiveGateway id="gw" name="succeeded?"/>
    <bpmn:userTask id="human_review" name="Human review"/>
    <bpmn:endEvent id="published"/>
    <bpmn:endEvent id="rejected"/>
    <bpmn:sequenceFlow sourceRef="start" targetRef="document_job"/>
    <bpmn:sequenceFlow sourceRef="document_job" targetRef="gw"/>
    <bpmn:sequenceFlow id="f_ok" sourceRef="gw" targetRef="human_review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${succeeded == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_bad" sourceRef="gw" targetRef="rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${succeeded == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow sourceRef="human_review" targetRef="published"/>
  </bpmn:process>
</bpmn:definitions>
